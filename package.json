{
  "name": "hesabdar-foroosh",
  "version": "1.7.0",
  "private": true,
  "description": "برنامه حسابداری حرفه‌ای فروش واسطه‌ای (باسلام + سایت فروشگاهی) روی Cloudflare Workers",
  "scripts": {
    "build": "node build.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init": "wrangler d1 execute hesabdar-db --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.60.0"
  }
}
