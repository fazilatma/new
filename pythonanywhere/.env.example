# install.sh generates these two secrets. Never commit .env.
S4_SECRET_KEY=
S4_PASSWORD=
S4_MAX_PAGES=20
S4_AUTO_EXTRACT_MINUTES=0
S4_TICK_BUDGET_SECONDS=240
S4_WORKER_STALE_SECONDS=900
SCRAPER_FETCH_TIMEOUT=25
SCRAPER_VERIFY_SSL=1
SCRAPER_RENDER_MODE=static
# Optional external JS renderer (POST /render, GET /health):
SCRAPER_RENDER_URL=
SCRAPER_RENDER_TOKEN=
# Leave S4_PROXY empty to use PythonAnywhere's environment HTTP(S)_PROXY.
S4_PROXY=
# Bootstrap defaults to API auto-provisioning. Disable only for local/non-PA installs:
# S4_AUTO_CONFIGURE=0 (pass to bootstrap/install process, not just this file)
# PythonAnywhere's API_TOKEN environment variable is read only during initial
# configure; credentials are then encrypted in SQLite for recurring reloads.
