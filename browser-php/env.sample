# متغیرهای سرویس رندر خالص‌PHP — با export قبل از start.sh یا از env کنسول
export RENDER_HOST=127.0.0.1          # فقط لوک‌بک — عمومی نکنید
export RENDER_PORT=3100
export RENDER_TOKEN=یک-راز-طولانی      # باید با پنل تنظیمات scraper4 یکی باشد

export RENDER_DRIVER=auto             # auto | cdp | selenium
export RENDER_MAX_CONCURRENCY=3       # = تعداد کارگرهای php -S
export RENDER_NAV_TIMEOUT=45000
export RENDER_QUEUE_WAIT_MS=10000
export RENDER_HEADLESS=true

# مسیر دستی باینری‌ها (اگر bootstrap استفاده نشود):
# export CHROME_BIN=/usr/bin/chromium
# export CHROMEDRIVER_BIN=/usr/bin/chromedriver
# یا سرویس WebDriver موجود:
# export SELENIUM_URL=http://127.0.0.1:4444
