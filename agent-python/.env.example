# Never commit real keys. Set only the providers you enable.
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
CLOUDFLARE_API_TOKEN=
# Persistent mutable provider catalog; do not point this to tracked seed data.
PROVIDERS_FILE=/var/lib/arena-agent/providers.json
