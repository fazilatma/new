# Arena Agent configuration. Copy to .env and edit. Every line is optional.

# --- first-run administrator (only used when the database has no users yet)
ARENA_ADMIN_USER=admin
ARENA_ADMIN_PASS=change-me

# --- turn authentication off for a private/local install
# ARENA_AUTH=false

# --- allow the terminal view to actually run commands
# ARENA_SHELL=false

# --- where state lives (defaults: ./data and ./storage next to this file)
# ARENA_DATA_DIR=/absolute/path/data
# ARENA_STORAGE_DIR=/absolute/path/storage

# --- encrypt provider keys with a passphrase instead of data/master.key
# ARENA_MASTER_KEY=a-long-random-string-at-least-32-characters

# --- timezone for stored timestamps
# ARENA_TZ=Asia/Tehran

# --- git
# ARENA_GIT=false                 turn git support off entirely
# ARENA_GIT_TOKEN=ghp_...         used for https push/pull; the UI can set this instead
