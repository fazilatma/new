# نمونهٔ متغیرهای browser.sh — به‌صورت env قبل از اجرا ست کنید
export RENDER_HOST=0.0.0.0
export RENDER_PORT=3100
export RENDER_TOKEN=یک-راز-طولانی           # خیلی مهم: بدون توکن سرویس باز است!

# درایور: auto | playwright | selenium
export RENDER_DRIVER=auto
# برای حالت پشتیبانِ Selenium (ایمیج جدا):
# export RENDER_DRIVER=selenium
# export SELENIUM_URL=http://127.0.0.1:4444

export RENDER_MAX_CONCURRENCY=3              # هر تبِ کرومیوم ~۲۰۰-۴۰۰ مگ رم
export RENDER_NAV_TIMEOUT=45000
export RENDER_HEADLESS=true
# export RENDER_BLOCK_HOSTS="googletagmanager.com,sentry.io"   # سرعت بیشتر

# سوپروایزر
export HEALTH_SEC=30                         # چک سلامت؛ 0 = خاموش
export HEALTH_FAILS=3
