APP_NAME="اسکرپر هوشمند"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/database/database.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# --- اسکرپر ---
# اگر سرور هنگام درخواست SSL بررسی نکند، این را true کنید (فقط موقت)
SCRAPER_VERIFY_SSL=true

# --- سرویس رندر جاوااسکریپت (browser/) ---
# آدرس سرویس Node که با browser.sh یا docker-compose اجرا شده
SCRAPER_RENDER_URL=http://127.0.0.1:3100
# باید با RENDER_TOKEN سرویس یکی باشد
SCRAPER_RENDER_TOKEN=
SCRAPER_RENDER_TIMEOUT_MS=60000
# load | domcontentloaded | networkidle
SCRAPER_RENDER_WAIT_UNTIL=domcontentloaded
SCRAPER_RENDER_SCROLL=false
# static = فقط ایستا | auto = تشخیص خودکار پوستهٔ JS | js = رندر همیشگی
SCRAPER_RENDER_MODE=static
