APP_NAME="scraper4"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa

LOG_CHANNEL=stack
LOG_LEVEL=debug

# پیش‌فرض سبک: SQLite فایل‌محور (مثل فایل‌های JSON قدیمی، بدون دیتابیسِ جدا)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# برای MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=scraper4
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# مسیر اپلیکیشنِ قدیمی (تک‌فایلی) — برای پلِ کران و ایمپورتِ وضعیت
SCRAPER_LEGACY_PATH=../scraper4.php
SCRAPER_LEGACY_DIR=..
