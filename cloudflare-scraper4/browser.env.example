# Optional browser overrides. Normal installations require none of these.
# Values are read from the service environment; this file is a reference,
# not automatically loaded by the server.

# Main defaults: Linux /tmp; Termux $PREFIX/tmp; Windows/macOS native temp.
# Use an absolute writable/searchable directory only when deliberately overriding:
# BROWSER_TMPDIR=/path/to/browser-temp

# auto (default): root/Termux compatibility, otherwise sandbox enabled.
# WARNING: true disables the Chromium sandbox. Prefer a non-root service.
# VISUAL_BROWSER_NO_SANDBOX=auto

# Troubleshooting only, never required for rendering:
# DEBUG=pw:browser
