{
  "name": "scraper4-cloudflare",
  "version": "1.34.0",
  "private": true,
  "description": "Cloudflare Workers-native Scraper 4 with D1, Queues, Cron, and downloadable backups",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "wrangler dev --ip 0.0.0.0",
    "render:build": "node build-render.mjs",
    "render:start": "node render-dist/server.js",
    "render:worker": "node render-dist/worker.js",
    "render:cron": "node render-dist/cron.js",
    "dev": "wrangler dev --ip 0.0.0.0",
    "typecheck": "npm run worker:typecheck",
    "test": "npm run worker:test",
    "parity:audit": "node scripts/parity-audit.mjs",
    "worker:build": "node build-worker.mjs",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "worker:dev": "wrangler dev --ip 0.0.0.0",
    "worker:test": "npm run worker:typecheck && npm run worker:build && node --test worker-tests/*.test.mjs",
    "worker:deploy": "node scripts/deploy-cloudflare.mjs",
    "worker:db:local": "wrangler d1 migrations apply DB --local",
    "worker:db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "cheerio": "^1.1.2",
    "hono": "^4.13.3",
    "pg": "^8.16.3",
    "read-excel-file": "^5.8.8",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.9",
    "fflate": "^0.7.4",
    "linkedom": "^0.18.12",
    "typescript": "^5.9.2",
    "wrangler": "^4.124.0"
  }
}
