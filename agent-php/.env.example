# Arena Coding Agent — PHP edition
# Copy to `.env` (same directory as this file) and fill in what you need.
# Everything here can also be edited at runtime from the
# "Security & Settings" tab, which writes to data/environment.json.

# ---------------------------------------------------------------- providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# GitHub integration (repos, pull requests, actions, token-authenticated clone)
GITHUB_TOKEN=

# Commit identity used by the built-in git client
GIT_AUTHOR_NAME=Arena Agent
GIT_AUTHOR_EMAIL=agent@localhost

# ------------------------------------------------------------------- proxy
# Either a gateway URL template (…?url={url}) or a real forward proxy
# (http://user:pass@host:port, socks5h://host:port — cURL supports both).
AGENT_PROXY_ENABLED=false
AGENT_PROXY_URL=

# -------------------------------------------------------------------- auth
# When AUTH_ENABLED=false there is no login screen at all: every request is
# treated as the anonymous superuser. Only do that behind a private network,
# an IP allow-list or an upstream reverse-proxy password.
AUTH_ENABLED=true
AGENT_AUTH_TOKEN=
AGENT_INITIAL_ADMIN_PASSWORD=admin123

# ----------------------------------------------------------------- runtime
REQUIRE_FILE_APPROVAL=false
MAX_CONCURRENT_JOBS=3
RATE_LIMIT_PER_MINUTE=200
MAX_RETRY_SLEEP_SEC=20
CORS_ORIGINS=*

# Spawn a one-shot worker process when a job is queued and no daemon is up.
AGENT_WORKER_AUTOSPAWN=true

# Run every shell command inside a throwaway Docker container instead of
# directly on the host (requires docker on PATH).
DOCKER_SANDBOX_ENABLED=false

# ---------------------------------------------------------------- local AI
# Offline models (Ollama runtime). The runtime is installed without root into
# AGENT_LOCALAI_DIR; relative paths resolve against the application root.
AGENT_LOCALAI_DIR=storage/localai
OLLAMA_MODELS=storage/localai/models
AGENT_LOCALAI_HOST=http://127.0.0.1:11434
# q8_0 halves the KV-cache RAM with no measurable quality loss.
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
# Override the assumed RAM bandwidth (GB/s) used for the tokens/s estimate.
AGENT_LOCALAI_CPU_BANDWIDTH=0
# AGENT_OLLAMA_BIN=/usr/local/bin/ollama
# AGENT_MODEL_CATALOG=/path/to/model_catalog.json

# ------------------------------------------------------------------- paths
# Defaults are relative to the application root; override for shared hosting
# where the data must live outside the document root.
# AGENT_DATA_DIR=/var/lib/arena-agent/data
# AGENT_STORAGE_DIR=/var/lib/arena-agent/storage
# AGENT_WORKSPACES_DIR=/var/lib/arena-agent/workspaces
# AGENT_MEMORY_LIMIT=512M
# AGENT_TZ=UTC
