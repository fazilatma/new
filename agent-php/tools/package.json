{
  "name": "agent-php-tools",
  "private": true,
  "type": "module",
  "description": "Static analysis helpers for hosts without a PHP binary.",
  "scripts": {
    "lint": "node phplint.mjs ../app ../bin ../public && node phpcheck.mjs ../app ../bin ../public",
    "routes": "node routecheck.mjs",
    "version": "node versioncheck.mjs",
    "php": "node phprun.mjs tests/import.php tests/routing.php"
  },
  "dependencies": {
    "php-parser": "3.7.0",
    "@php-wasm/node": "3.1.56",
    "@php-wasm/universal": "3.1.56"
  }
}
