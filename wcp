        echo -e "  [✓] Node.js: $(node -v) (npm $(npm -v 2>/dev/null || echo 'not found'))"
    else
        echo -e "  [✗] Node.js is missing!"
    fi
    
    if command -v python3 >/dev/null 2>&1; then
        echo -e "  [✓] Python Runtime: $(python3 --version)"
        python3 -c "import requests, flask, bs4, curl_cffi, playwright; print('  [✓] Scraping Stack: requests, curl_cffi, playwright, flask all verified.')" 2>/dev/null || echo -e "  [⚠️] Some Python scraping packages need installation."
    else
        echo -e "  [✗] Python 3 is missing!"
    fi

    if pgrep apache2 >/dev/null 2>&1 || pgrep httpd >/dev/null 2>&1; then
        echo -e "  [✓] Apache2 Web Server: Running"
    else
        echo -e "  [⚠️] Apache2 is stopped. Start with: service apache2 start"
    fi

    echo "--------------------------------------------------------------------------------"
    cmd_url
}

cmd_rebuild() {
    banner
    echo -e "${CLR_YELLOW}🔄 Requesting Codespaces container rebuild with persistent ports...${CLR_RESET}"
    if command -v gh >/dev/null 2>&1; then
        local cs_name="${CODESPACE_NAME:-}"
        if [ -n "$cs_name" ]; then
            gh codespace rebuild -c "$cs_name" 2>/dev/null || true
            echo -e "${CLR_GREEN}✓ Rebuild command dispatched.${CLR_RESET}"
            return 0
        fi
    fi
    echo -e "${CLR_CYAN}In VS Code, press Ctrl+Shift+P and select 'Codespaces: Rebuild Container'.${CLR_RESET}"
}

# Main command dispatcher
case "${1:-}" in
    status|info)
        cmd_status
        ;;
    url|links)
        cmd_url
        ;;
    proj|projects)
        case "${2:-}" in
            start) cmd_start_proj "${3:-}" ;;
            stop) cmd_stop_proj "${3:-}" ;;
            restart) cmd_stop_proj "${3:-}"; sleep 1; cmd_start_proj "${3:-}" ;;
            logs) cmd_logs "${3:-}" ;;
            *) cmd_proj_list ;;
        esac
        ;;
    start)
        cmd_start_proj "${2:-}"
        ;;
    stop)
        cmd_stop_proj "${2:-}"
        ;;
    restart)
        cmd_stop_proj "${2:-}"
        sleep 1
        cmd_start_proj "${2:-}"
        ;;
    run-all|start-all|up)
        cmd_run_all
        ;;
    stop-all|down)
        cmd_stop_all
        ;;
    restart-all)
        cmd_restart_all
        ;;
    logs|log)
        cmd_logs "${2:-}"
        ;;
    ports)
        cmd_ports
        ;;
    killport)
        cmd_killport "${2:-}"
        ;;
    swap)
        cmd_swap "${2:-}"
        ;;
    pass|password)
        cmd_pass "${2:-}"
        ;;
    update|self-update)
        cmd_update
        ;;
    doctor|check)
        cmd_doctor
        ;;
    rebuild)
        cmd_rebuild
        ;;
    help|--help|-h|"")
        cmd_help
        ;;
    *)
        echo -e "${CLR_RED}Unknown command: $1${CLR_RESET}"
        cmd_help
        exit 1
        ;;
esac
