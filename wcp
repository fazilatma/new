cmd_help() {
    banner
    cmd_table
}

cmd_status() {
    banner
    echo -e "${CLR_BOLD}System Metrics & Resource Overview:${CLR_RESET}"
    echo "--------------------------------------------------------------------------------"
    local mem_total=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{printf "%.2f GB", $2/1024/1024}')
    local mem_free=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{printf "%.2f GB", $2/1024/1024}')
    local swap_total=$(grep SwapTotal /proc/meminfo 2>/dev/null | awk '{printf "%.2f GB", $2/1024/1024}')
    local swap_free=$(grep SwapFree /proc/meminfo 2>/dev/null | awk '{printf "%.2f GB", $2/1024/1024}')
    local cores=$(nproc 2>/dev/null || echo "1")
    
    echo -e "  • ${CLR_BOLD}Processor (CPU):${CLR_RESET}      ${cores} Core(s)"
    echo -e "  • ${CLR_BOLD}Physical RAM:${CLR_RESET}         ${mem_total} Total (Available: ${mem_free})"
    echo -e "  • ${CLR_BOLD}Virtual Swap:${CLR_RESET}         ${swap_total} Total (Available: ${swap_free})"
    
    local ap_stat="Inactive"
    if pgrep apache2 >/dev/null 2>&1 || pgrep httpd >/dev/null 2>&1; then
        ap_stat="${CLR_GREEN}Active (Running)${CLR_RESET}"
    fi
    local php_stat="Inactive"
    if pgrep -f 'php -S 0.0.0.0' >/dev/null 2>&1; then
        php_stat="${CLR_GREEN}Active on Ports 8888 & 8000${CLR_RESET}"
    fi
    echo -e "  • ${CLR_BOLD}Apache2 Web Server:${CLR_RESET}   ${ap_stat}"
    echo -e "  • ${CLR_BOLD}PHP Application Server:${CLR_RESET} ${php_stat}"
    echo "--------------------------------------------------------------------------------"
    cmd_url
    cmd_proj_list
}

cmd_url() {
    local cs_name="${CODESPACE_NAME:-}"
    if [ -z "$cs_name" ] && [ -r /proc/1/environ ]; then
        cs_name=$(tr '\0' '\n' < /proc/1/environ 2>/dev/null | grep -E '^CODESPACE_NAME=' | cut -d'=' -f2- | tr -d '"\r\n' || true)
    fi
    local cs_domain="${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev}"
    local ip=$(curl -s4m 2 ifconfig.me || hostname -I | awk '{print $1}' || echo "127.0.0.1")

    if [ -n "${TERMUX_VERSION:-}" ] || [ -d "/data/data/com.termux" ]; then
        echo -e "${CLR_BOLD}📱 Android Termux Access Endpoints:${CLR_RESET}"
        echo -e "  🐘 ${CLR_GREEN}${CLR_BOLD}http://localhost:8888/${CLR_RESET} (or ${CLR_CYAN}http://127.0.0.1:8888/${CLR_RESET})"
        echo -e "  🐘 ${CLR_CYAN}http://localhost:8000/${CLR_RESET}"
    elif [ -n "$cs_name" ] && [ "$cs_name" != "codespace" ]; then
        echo -e "${CLR_BOLD}🌐 GitHub Codespaces Access Endpoints:${CLR_RESET}"
        echo -e "  🐘 ${CLR_GREEN}${CLR_BOLD}https://${cs_name}-8888.${cs_domain}/${CLR_RESET} (Primary WebConsole)"
        echo -e "  🐘 ${CLR_CYAN}https://${cs_name}-8000.${cs_domain}/${CLR_RESET} (Alternate WebConsole)"
        echo -e "  🟢 ${CLR_MAGENTA}https://${cs_name}-3000.${cs_domain}/${CLR_RESET} (Node.js Application)"
        echo -e "  🐍 ${CLR_YELLOW}https://${cs_name}-8081.${cs_domain}/${CLR_RESET} (Python Scraper Service)"
    else
        echo -e "${CLR_BOLD}🌐 Server Access Endpoints:${CLR_RESET}"
        echo -e "  🐘 ${CLR_GREEN}${CLR_BOLD}http://${ip}:8888/${CLR_RESET}"
        echo -e "  🐘 ${CLR_CYAN}http://${ip}:8000/${CLR_RESET}"
        echo -e "  🐘 ${CLR_CYAN}http://${ip}/${CLR_RESET}"
    fi
    echo ""
}

