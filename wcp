cmd_start_proj() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo -e "${CLR_RED}Usage: wcp start <project_id_or_name>${CLR_RESET}"
        return 1
    fi
    echo -e "${CLR_BLUE}Starting project ${target}...${CLR_RESET}"
    python3 -c "
import json, os, subprocess

pfile = '$PROJECTS_JSON'
cache_dir = '$CACHE_DIR'
target = '$target'.strip()

if not os.path.exists(pfile):
    print('Projects file not found.')
    exit(1)

with open(pfile, 'r') as f:
    projects = json.load(f)

matched = [p for p in projects if p.get('id') == target or p.get('name') == target or target in p.get('id', '')]
if not matched:
    print(f'Project \"{target}\" not found.')
    exit(1)

proj = matched[0]
pid_file = os.path.join(cache_dir, f'svc-{proj[\"id\"]}.pid')
runner_file = os.path.join(cache_dir, f'svc-run-{proj[\"id\"]}.sh')

if not os.path.exists(runner_file):
    print(f'Runner script not found for project {proj[\"name\"]}. Please deploy it once via WebConsole.')
    exit(1)

# Kill previous instance
if os.path.exists(pid_file):
    try:
        with open(pid_file) as pf:
            old_pid = pf.read().strip()
            if old_pid.isdigit():
                subprocess.run(['kill', '-9', old_pid], stderr=subprocess.DEVNULL)
    except: pass

log_file = os.path.join(cache_dir, f'svc-{proj[\"id\"]}.log')
os.chmod(runner_file, 0o775)
cmd = f'nohup bash {runner_file} > {log_file} 2>&1 &'
proc = subprocess.Popen(cmd, shell=True, preexec_fn=os.setpgrp)
with open(pid_file, 'w') as pf:
    pf.write(str(proc.pid))

print(f'\033[1;32m✓ Project \"{proj.get(\"name\")}\" started successfully (PID: {proc.pid})!\033[0m')
print(f'  Logs: wcp logs {proj[\"id\"]}')
"
}

cmd_stop_proj() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo -e "${CLR_RED}Usage: wcp stop <project_id_or_name>${CLR_RESET}"
        return 1
    fi
    python3 -c "
import json, os, subprocess

pfile = '$PROJECTS_JSON'
cache_dir = '$CACHE_DIR'
target = '$target'.strip()

if not os.path.exists(pfile): exit(1)
with open(pfile) as f: projects = json.load(f)

matched = [p for p in projects if p.get('id') == target or p.get('name') == target or target in p.get('id', '')]
if not matched:
    print(f'Project \"{target}\" not found.')
    exit(1)

proj = matched[0]
pid_file = os.path.join(cache_dir, f'svc-{proj[\"id\"]}.pid')

if os.path.exists(pid_file):
    with open(pid_file) as pf:
        val = pf.read().strip()
        if val.isdigit():
            subprocess.run(['kill', '-9', val], stderr=subprocess.DEVNULL)
            subprocess.run(['pkill', '-P', val], stderr=subprocess.DEVNULL)
    try: os.remove(pid_file)
    except: pass

if proj.get('port'):
    subprocess.run(f'fuser -k {proj[\"port\"]}/tcp', shell=True, stderr=subprocess.DEVNULL)

print(f'\033[1;33m✓ Project \"{proj.get(\"name\")}\" stopped.\033[0m')
"
}

cmd_run_all() {
    banner
    echo -e "${CLR_BOLD}🚀 Launching All Configured Active Projects...${CLR_RESET}"
    echo "--------------------------------------------------------------------------------"
    python3 -c "
import json, os, subprocess

pfile = '$PROJECTS_JSON'
cache_dir = '$CACHE_DIR'

if not os.path.exists(pfile):
    print('No projects found.')
    exit(0)

with open(pfile, 'r') as f:
    projects = json.load(f)

if not projects:
    print('No projects found.')
    exit(0)

started = 0
for proj in projects:
    pid_file = os.path.join(cache_dir, f'svc-{proj[\"id\"]}.pid')
    runner_file = os.path.join(cache_dir, f'svc-run-{proj[\"id\"]}.sh')
    
    if not os.path.exists(runner_file):
        continue
    
    # Check if already running
    running = False
    if os.path.exists(pid_file):
        try:
            with open(pid_file) as pf:
                val = pf.read().strip()
                if val.isdigit() and os.path.exists(f'/proc/{val}'):
                    running = True
        except: pass
    
    if running:
        print(f'  • \033[1;32m[Active]\033[0m  {proj[\"name\"]} is already running.')
        continue
    
    log_file = os.path.join(cache_dir, f'svc-{proj[\"id\"]}.log')
    os.chmod(runner_file, 0o775)
    cmd = f'nohup bash {runner_file} > {log_file} 2>&1 &'
    proc = subprocess.Popen(cmd, shell=True, preexec_fn=os.setpgrp)
    with open(pid_file, 'w') as pf:
        pf.write(str(proc.pid))
    
    print(f'  • \033[1;32m[Started]\033[0m {proj[\"name\"]} (PID: {proc.pid}, Port: {proj.get(\"port\", \"—\")})')
    started += 1

print('--------------------------------------------------------------------------------')
print(f'\033[1;32m✓ All active project services launched ({started} started).\033[0m\n')
"
    cmd_proj_list
}

