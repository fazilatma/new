cmd_restart_all() {
    cmd_stop_all
    sleep 1
    cmd_run_all
}

cmd_logs() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo -e "${CLR_RED}Usage: wcp logs <project_id_or_name>${CLR_RESET}"
        return 1
    fi
    local log_file=""
    for f in "${CACHE_DIR}/svc-${target}.log" "${CACHE_DIR}/svc-"*"${target}"*".log"; do
        if [ -f "$f" ]; then log_file="$f"; break; fi
    done
    if [ -z "$log_file" ] || [ ! -f "$log_file" ]; then
        echo -e "${CLR_RED}No log file found for project ${target}.${CLR_RESET}"
        return 1
    fi
    echo -e "${CLR_CYAN}Tailing live logs from ${log_file} (Press Ctrl+C to exit):${CLR_RESET}\n"
    tail -n 60 -f "$log_file"
}

cmd_ports() {
    banner
    echo -e "${CLR_BOLD}Active Listening TCP Ports & Sockets:${CLR_RESET}"
    echo "--------------------------------------------------------------------------------"
    if command -v ss >/dev/null 2>&1; then
        ss -tulpn | grep LISTEN || true
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tulpn | grep LISTEN || true
    else
        lsof -iTCP -sTCP:LISTEN -P -n || true
    fi
    echo "--------------------------------------------------------------------------------"
    echo -e "💡 To terminate process on a port: ${CLR_YELLOW}wcp killport <port_number>${CLR_RESET}"
}

cmd_killport() {
    local port="${1:-}"
    if [ -z "$port" ]; then
        echo -e "${CLR_RED}Usage: wcp killport <port>${CLR_RESET}"
        return 1
    fi
    echo -e "${CLR_YELLOW}Terminating process listening on port ${port}...${CLR_RESET}"
    fuser -k "${port}/tcp" 2>/dev/null || true
    echo -e "${CLR_GREEN}✓ Port ${port} freed successfully.${CLR_RESET}"
}

cmd_swap() {
    local sz="${1:-}"
    if [ -z "$sz" ]; then
        echo -e "${CLR_BOLD}Virtual Swap Memory Status:${CLR_RESET}"
        swapon --show 2>/dev/null || free -h
        echo -e "\nTo resize: ${CLR_YELLOW}wcp swap 4096${CLR_RESET} (in Megabytes)"
        return 0
    fi
    echo -e "${CLR_BLUE}Resizing Swap memory to ${sz}MB...${CLR_RESET}"
    swapoff -a 2>/dev/null || true
    rm -f /swapfile 2>/dev/null || true
    if command -v fallocate >/dev/null 2>&1; then
        fallocate -l "${sz}M" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count="${sz}" 2>/dev/null
    else
        dd if=/dev/zero of=/swapfile bs=1M count="${sz}" 2>/dev/null
    fi
    chmod 600 /swapfile
    mkswap /swapfile >/dev/null 2>&1
    swapon /swapfile 2>/dev/null || true
    echo -e "${CLR_GREEN}✓ Swap memory resized to ${sz}MB and activated.${CLR_RESET}"
}

cmd_pass() {
    local new_pass="${1:-}"
    if [ -z "$new_pass" ]; then
        read -s -p "Enter new WebConsole master administrator password: " new_pass
        echo ""
    fi
    if [ -z "$new_pass" ]; then
        echo -e "${CLR_RED}Password cannot be empty.${CLR_RESET}"
        return 1
    fi
    local hash=$(php -r "echo password_hash('$new_pass', PASSWORD_BCRYPT);")
    python3 -c "
import json, os, glob
cfg_paths = glob.glob('/var/www/*/.wconsole_data/config.json') + glob.glob('/workspaces/*/.wconsole_data/config.json') + ['/var/www/html/.wconsole_data/config.json']
for p in set(cfg_paths):
    if os.path.exists(p):
        try:
            with open(p, 'r') as f: d = json.load(f)
            d['pass_hash'] = '$hash'
            with open(p, 'w') as f: json.dump(d, f, indent=2)
            print('✓ Password updated in ' + p)
        except Exception as e: pass
"
    echo -e "${CLR_GREEN}✓ Master password updated successfully.${CLR_RESET}"
}

