#!/usr/bin/env bash
# ==============================================================================
# WebConsole Pro Universal CLI Tool (wcp)
# Supports: All Linux Distributions (Debian, Ubuntu, CentOS, RHEL, Rocky,
#           AlmaLinux, Fedora, Alpine, Arch) and GitHub Codespaces
# Version: 1.7.0 | Repository: fazilatma/new
# ==============================================================================

set -eo pipefail

# ANSI Colors
CLR_RESET="\033[0m"
CLR_BOLD="\033[1m"
CLR_GREEN="\033[1;32m"
CLR_BLUE="\033[1;34m"
CLR_CYAN="\033[1;36m"
CLR_YELLOW="\033[1;33m"
CLR_MAGENTA="\033[1;35m"
CLR_RED="\033[1;31m"
CLR_GRAY="\033[0;90m"

# Find WebConsole Data Directory
find_wcp_data_dir() {
    for d in /var/www/html/.wconsole_data \
             /workspaces/*/.wconsole_data \
             /workspaces/.wconsole_data \
             /var/www/.wconsole_data \
             ${HOME}/.wconsole_data; do
        if [ -d "$d" ]; then
            echo "$d"
            return
        fi
    done
    echo "/var/www/html/.wconsole_data"
}

WCP_DATA_DIR=$(find_wcp_data_dir)
PROJECTS_JSON="${WCP_DATA_DIR}/projects.json"
CACHE_DIR="${WCP_DATA_DIR}/cache"
RUNNER_DIR="${WCP_DATA_DIR}/runners"
mkdir -p "$CACHE_DIR" "$RUNNER_DIR" 2>/dev/null || true

banner() {
    echo -e "${CLR_CYAN}${CLR_BOLD}"
    echo "================================================================================"
    echo "       🚀 WebConsole Pro Universal CLI Manager (wcp v1.7.5)                     "
    echo "================================================================================"
    echo -e "${CLR_RESET}"
}

